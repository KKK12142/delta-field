{
  "name": "delta-field",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc && tsc -p server",
    "build": "tsc && tsc -p server && vite build",
    "preview": "vite preview",
    "share": "bash scripts/share.sh on",
    "share:off": "bash scripts/share.sh off",
    "share:status": "bash scripts/share.sh status",
    "playtest": "node scripts/playtest.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "bots": "node scripts/bots.mjs",
    "art:gen": "node --env-file-if-exists=$HOME/.config/delta-field/baze.env scripts/art/generate.mjs",
    "art:fit": "node scripts/art/fit.mjs",
    "art:grid": "node scripts/art/grid.mjs",
    "dev:server": "node --watch --env-file-if-exists=.env server/main.ts",
    "start": "pnpm build && NODE_ENV=production node --env-file-if-exists=.env server/main.ts",
    "art:models": "node --env-file-if-exists=$HOME/.config/delta-field/baze.env scripts/art/models.mjs",
    "art:board": "node scripts/art/board.mjs",
    "art:palette": "node scripts/art/palette.mjs",
    "art:walk": "node scripts/art/walk.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/schema": "5.0.42",
    "@colyseus/sdk": "0.18.8",
    "@colyseus/ws-transport": "0.18.4",
    "express": "5.3.0",
    "phaser": "4.2.1",
    "qrcode-generator": "1.4.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
